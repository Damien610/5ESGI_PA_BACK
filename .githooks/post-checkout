#!/bin/bash
# Hook Git pour appliquer automatiquement les migrations après un changement de branche

PREV_COMMIT=$1
NEW_COMMIT=$2
BRANCH_SWITCH=$3

# Vérifier si c'est un changement de branche
if [ "$BRANCH_SWITCH" = "1" ]; then
    echo "🔄 Changement de branche détecté"
    
    # Vérifier si des fichiers de migration ont changé
    if git diff --name-only $PREV_COMMIT $NEW_COMMIT | grep -q "alembic/versions/"; then
        echo "📦 Migrations détectées, application automatique..."
        
        # Vérifier si le container est en cours d'exécution
        if docker ps | grep -q "fastapi_projet_dev"; then
            docker exec fastapi_projet_dev alembic upgrade head
            echo "✅ Migrations appliquées"
        else
            echo "⚠️ Container non démarré. Lancez 'make dev-up' puis 'make upgrade'"
        fi
    fi
fi
